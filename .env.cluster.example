# =============================================================================
#  Entorno del stack en cluster (docker-compose.cluster.yml).
#  Copiar a .env.cluster:   cp .env.cluster.example .env.cluster
#
#  Diferencias frente a .env.dev (stack de 1 solo backend):
#   · No se publica el puerto de SQL Server: vive en una red interna.
#   · SKIP_DB_INIT lo fuerza docker-compose (true en los backends, false en
#     db-init); no hace falta tocarlo aquí.
# =============================================================================

# ── Workers de uvicorn por backend (3 backends × N workers) ─────────────────
UVICORN_WORKERS=2

# ── Contenedor de SQL Server ─────────────────────────────────────────────────
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=TimeShift@Dev2024

# ── Conexión a la base de datos ──────────────────────────────────────────────
# DB_HOST lo fuerza docker-compose a "sqlserver" (nombre en la red privada).
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=sqlserver
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=TimeShift@Dev2024
DB_TRUSTED_CONNECTION=no

# ── JWT / seguridad ──────────────────────────────────────────────────────────
# Debe ser LA MISMA en los 3 backends o los tokens fallarán al saltar de uno
# a otro. Como es una sola variable compartida, queda garantizado.
SECRET_KEY=dev-secret-key-change-in-production
SECURITY_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_REQUESTS_PER_MINUTE=100

# ── Aplicación ───────────────────────────────────────────────────────────────
APP_NAME=TimeShiftZone API
LOG_LEVEL=DEBUG
SHIFT_BEFORE_MINUTES_MARGIN=15
FRONTEND_URL=http://localhost:8000
PROFILE_PICTURES_PATH=/code/app/static/images

# ── Integraciones externas ───────────────────────────────────────────────────
# Comentada a propósito: si la dejas vacía machacas el valor de app/.env.
#GOOGLE_API_KEY=

# ── Email ────────────────────────────────────────────────────────────────────
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USERNAME=dev@timeshift.local
SMTP_PASSWORD=dev
SMTP_SSL=false
SMTP_TLS=false
SENDER_EMAIL=dev@timeshift.local

# ── Las 3 bases de datos y sus backups ───────────────────────────────────────
# Los .bak se buscan en backups/ (montado como /backups en los contenedores).
# Si un .bak no existe, esa base se crea vacía con el esquema de los modelos.
DB_NAME_1=timeshift_1
DB_NAME_2=timeshift_2
DB_NAME_3=timeshift_3
BAK_FILE_1=timeshift_1.bak
BAK_FILE_2=timeshift_2.bak
BAK_FILE_3=timeshift_3.bak

# true → rehace las 3 bases aunque ya existan (WITH REPLACE). Destructivo.
FORCE_RESTORE=false
# tras restaurar, create_all() añade las tablas que el backup no trajera
MIGRATE_AFTER_RESTORE=true

# ── Puertos publicados ───────────────────────────────────────────────────────
GATEWAY_PORT=8000     # enrutado por Host: t1/t2/t3.localhost
BACKEND_1_PORT=8001   # acceso directo a backend-1 (timeshift_1)
BACKEND_2_PORT=8002   # acceso directo a backend-2 (timeshift_2)
BACKEND_3_PORT=8003   # acceso directo a backend-3 (timeshift_3)
