# ── Artefactos pesados que no deben entrar en la imagen ──────────────────────
*.bak
app/logs/*
docker/logs/
timeshift_*.bak

# ── Ficheros propios de docker (no hacen falta dentro de la imagen) ──────────
docker-compose*.yml
