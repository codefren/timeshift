# =============================================================================
#  Plantilla de entorno para el stack Docker de TimeShift.
#  Copiar a .env.dev y ajustar:   cp .env.docker.example .env.dev
#
#  Este fichero cumple dos funciones:
#   1. `env_file:` del servicio backend  → variables dentro del contenedor.
#   2. Interpolación de docker-compose   → solo si arrancas con
#      `docker compose --env-file .env.dev up -d` (si no, se usan los
#      valores por defecto escritos en docker-compose.yml).
# =============================================================================

# ── Puertos publicados en el host ────────────────────────────────────────────
BACKEND_PORT=8000
SQLSERVER_PORT=1433

# ── Contenedor de SQL Server ─────────────────────────────────────────────────
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=TimeShift@Dev2024

# ── Conexión a la base de datos (la usa el backend) ──────────────────────────
# DB_HOST lo fuerza docker-compose a "sqlserver"; aquí queda como referencia.
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=timeshift
DB_USERNAME=sa
DB_PASSWORD=TimeShift@Dev2024
DB_TRUSTED_CONNECTION=no

# true → no crea esquema ni datos iniciales (útil tras restaurar un .bak)
SKIP_DB_INIT=false

# ── JWT / seguridad ──────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production
SECURITY_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_REQUESTS_PER_MINUTE=100

# ── Aplicación ───────────────────────────────────────────────────────────────
APP_NAME=TimeShift API (Dev)
LOG_LEVEL=DEBUG
SHIFT_BEFORE_MINUTES_MARGIN=15
FRONTEND_URL=http://localhost:8000
# Ruta donde se guardan las fotos de perfil; coincide con el volumen
# "profile-pictures" declarado en docker-compose.yml.
PROFILE_PICTURES_PATH=/code/app/static/images

# ── Integraciones externas ───────────────────────────────────────────────────
# Déjala comentada si ya tienes la clave en app/.env: el contenedor monta ./app,
# y load_dotenv() rellena lo que no venga ya del entorno. Si la defines aquí
# vacía, machacarás el valor de app/.env.
#GOOGLE_API_KEY=

# ── Email (desactivado en dev) ───────────────────────────────────────────────
SMTP_SERVER=localhost
SMTP_PORT=587
SMTP_USERNAME=dev@timeshift.local
SMTP_PASSWORD=dev
SMTP_SSL=false
SMTP_TLS=false
SENDER_EMAIL=dev@timeshift.local

# ── Restauración de backups (perfil "restore") ───────────────────────────────
BAK_FILE=timeshift_20250610.bak
